# ============================================================================
# MnIntel — MOIL Mining Intelligence Center Environment Variables
# ============================================================================

# Backend Port (Defaults to 3000)
PORT=3000

# Database Configuration
# Defaults to embedded SQLite (backend/data/mnintel.db) using native node:sqlite.
# Optionally provide a PostgreSQL connection string: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Copernicus Data Space Ecosystem (CDSE) / Sentinel-2 API Credentials
# Register at https://dataspace.copernicus.eu/ to obtain OAuth2 client credentials
COPERNICUS_CLIENT_ID=sh-a2d30b8f-64dd-4d6e-8fff-e9186f61b464
COPERNICUS_CLIENT_SECRET=sySp5Ysf9Nq8EOslkMAUHAcjsuSr86Py

# Automated Weather Provider (Open-Meteo)
WEATHER_PROVIDER=open-meteo

# Frontend Environment Variable (Vercel deployment)
# In production, set this in Vercel to your public Render backend URL + /api:
# Example: VITE_API_BASE_URL=https://mnintel-backend.onrender.com/api
# Locally defaults to http://localhost:3000/api
VITE_API_BASE_URL=http://localhost:3000/api
